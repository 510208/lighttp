{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LigHTTP",
  "version": "0.6.0",
  "identifier": "com.samhacker.lighttp",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "LigHTTP",
        "width": 800,
        "height": 700,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self' tauri: localhost https://tauri.localhost; script-src 'self' 'unsafe-inline' 'unsafe-eval' blob: https://cdn.jsdelivr.net ipc: http://ipc.localhost; worker-src 'self' blob: tauri: localhost https://tauri.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data: https://gravatar.com https://github.com https://*.githubusercontent.com; font-src 'self' data:; connect-src 'self' https://api.github.com https://cdn.jsdelivr.net ipc: http://ipc.localhost"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ2MEE0NEFGQURCOUZFM0MKUldROC9ybXRyMFFLUmpsN2FPUTRXaGNZZkxnS0Z2dUc2MzZtaTVMTU5lWjA0NCtPRTNpd0JpcEcK",
      "endpoints": [
        "https://github.com/510208/lighttp/releases/latest/download/latest.json"
      ]
    },
    "cli": {
      "description": "LigHTTP, an API Client's CLI",
      "args": [
        {
          "name": "file",
          "index": 1,
          "description": ".lghttp.json file path",
          "takesValue": true
        }
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],

    "windows": {
      "nsis": {
        "languages": ["English", "TradChinese"],
        "displayLanguageSelector": true,
        "installerHooks": "./installer_hooks.nsh"
      }
    },

    "fileAssociations": [
      {
        "ext": ["json"],
        "name": "JSON File via LigHTTP",
        "description": "Open JSON configuration with LigHTTP",
        "mimeType": "application/json",
        "role": "Viewer",
        "rank": "Alternate"
      }
    ],

    "createUpdaterArtifacts": true
  }
}
